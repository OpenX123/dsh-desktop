{
  "name": "dsh-desktop",
  "description": "Standalone desktop client for DeepSeek Harness: an independent Electron application consuming the official harness packages (a sibling checkout) without modifying them",
  "version": "0.0.1-rc.1",
  "private": true,
  "type": "module",
  "main": ".build/main.mjs",
  "license": "BSD-3-Clause",
  "scripts": {
    "build:renderer": "vite build",
    "build:shell": "esbuild src/main/index.ts --bundle --platform=node --format=esm --external:electron --outfile=.build/main.mjs && esbuild src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=.build/preload.cjs",
    "build": "npm run build:renderer && npm run build:shell",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "shot": "node scripts/shot.mjs",
    "audit": "node scripts/audit.mjs",
    "e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c .oxlintrc.json src scripts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "link:../test-bruc3van/vendor/cordis",
    "@deepseek-ai/cordis-plugin-include": "link:../test-bruc3van/vendor/include",
    "@deepseek-ai/cordis-plugin-loader": "link:../test-bruc3van/vendor/loader",
    "@deepseek-ai/dsh-app-boot": "link:../test-bruc3van/packages/boot/app-boot",
    "@deepseek-ai/dsh-base": "link:../test-bruc3van/packages/bundle/base",
    "@deepseek-ai/dsh-bash-env": "link:../test-bruc3van/packages/bash/bash-env",
    "@deepseek-ai/dsh-cmdline": "link:../test-bruc3van/packages/boot/cmdline",
    "@deepseek-ai/dsh-client-connection": "link:../test-bruc3van/packages/client/connection",
    "@deepseek-ai/dsh-environment": "link:../test-bruc3van/packages/util/environment",
    "@deepseek-ai/dsh-host-apiproxy": "link:../test-bruc3van/packages/host/apiproxy",
    "@deepseek-ai/dsh-host-directory-picker-auto": "link:../test-bruc3van/packages/host/directory-picker-auto",
    "@deepseek-ai/dsh-host-webserver": "link:../test-bruc3van/packages/host/webserver",
    "@deepseek-ai/dsh-llm": "link:../test-bruc3van/packages/llm/llm",
    "@deepseek-ai/dsh-message-feedback": "link:../test-bruc3van/packages/feedback/message-feedback",
    "@deepseek-ai/dsh-paths": "link:../test-bruc3van/packages/util/paths",
