    "@deepseek-ai/dsh-tool-subagent": "link:../test-bruc3van/../test-bruc3van/packages/subagent/tool-subagent",
    "@deepseek-ai/dsh-tool-subagent-control": "link:../test-bruc3van/../test-bruc3van/packages/subagent/tool-subagent-control",
