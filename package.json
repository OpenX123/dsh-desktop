    "@deepseek-ai/dsh-storage-json": "link:../test-bruc3van/packages/storage/storage-json",
    "@deepseek-ai/dsh-system-prompt": "link:../test-bruc3van/packages/core/system-prompt",
    "@deepseek-ai/dsh-user-interaction": "link:../test-bruc3van/packages/interaction/user-interaction",
    "@deepseek-ai/dsh-workspace": "link:../test-bruc3van/packages/workspace/workspace",
    "commander": "^15.0.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.3",
    "@deepseek-ai/dsh-api-remotes": "link:../test-bruc3van/packages/api/remotes",
