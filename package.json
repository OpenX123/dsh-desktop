    "@deepseek-ai/dsh-command-compact": "link:../test-bruc3van/../test-bruc3van/packages/compact/command-compact",
    "@deepseek-ai/dsh-compact-basic": "link:../test-bruc3van/../test-bruc3van/packages/compact/compact-basic",
    "@deepseek-ai/dsh-compact-tool-result-prune": "link:../test-bruc3van/../test-bruc3van/packages/compact/compact-tool-result-prune",
    "@deepseek-ai/dsh-fs-local": "link:../test-bruc3van/../test-bruc3van/packages/fs/fs-local",
