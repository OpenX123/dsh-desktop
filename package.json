    "@deepseek-ai/dsh-tool-bash-persistent": "link:../test-bruc3van/../test-bruc3van/packages/pty/tool-bash-persistent",
    "@deepseek-ai/dsh-tool-cordis": "link:../test-bruc3van/../test-bruc3van/packages/self-modification/tool-cordis",
