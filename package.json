  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^39.0.0",
    "esbuild": "^0.25.0",
    "oxlint": "^1.0.0",
    "playwright-core": "^1.49.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  }
}
