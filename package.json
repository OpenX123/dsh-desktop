{
  "name": "dsh-desktop",
  "description": "Standalone desktop client for DeepSeek Harness: an independent Electron application consuming only the public interface of the official dsh Web UI (its CLI and its /api wire contract) — no internal harness packages",
  "version": "0.0.1-rc.1",
  "private": true,
  "type": "module",
  "main": ".build/main.mjs",
  "license": "MIT",
  "scripts": {
    "build:renderer": "vite build",
    "build:shell": "esbuild src/main/index.ts --bundle --platform=node --format=esm --external:electron --outfile=.build/main.mjs && esbuild src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=.build/preload.cjs",
    "build": "npm run build:shell",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "shot": "node scripts/shot.mjs",
    "audit": "node scripts/audit.mjs",
    "e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c .oxlintrc.json src scripts"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^39.0.0",
    "esbuild": "^0.25.0",
    "oxlint": "^1.0.0",
    "playwright-core": "^1.49.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh": "0.0.1-rc.1"
  }
}
