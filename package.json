{
  "name": "dsh-desktop",
  "description": "DeepSeek Harness 独立桌面客户端 / Independent desktop client powered by the official dsh Web UI",
  "version": "0.0.1-rc.1",
  "private": true,
  "type": "module",
  "main": ".build/main.mjs",
  "author": "bruc3van",
  "homepage": "https://github.com/bruc3van/dsh-desktop#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/bruc3van/dsh-desktop.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build:renderer": "vite build",
    "build:shell": "esbuild src/main/index.ts --bundle --platform=node --format=esm --external:electron --outfile=.build/main.mjs && esbuild src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=.build/preload.cjs",
    "build": "npm run build:shell",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "shot": "node scripts/shot.mjs",
    "audit": "node scripts/audit.mjs",
    "e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c .oxlintrc.json src scripts"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^39.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "oxlint": "^1.0.0",
    "playwright-core": "^1.49.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0"
  }
}
